{
  "name": "dsh-session-rail",
  "version": "0.1.16",
  "type": "module",
  "description": "Session status at a glance for the DSH Web UI: five-state header counters (running / asking / error / interrupted / unread), a pinned hover panel, per-workspace badges in the left rail, and a Progress tab for long tasks.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zengxiaolou/dsh-session-rail.git"
  },
  "homepage": "https://github.com/zengxiaolou/dsh-session-rail",
  "bugs": {
    "url": "https://github.com/zengxiaolou/dsh-session-rail/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "status",
    "sidebar",
    "workspace",
    "counters"
  ],
  "license": "MIT"
}
