{
  "name": "@local/dsh-session-rail",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Progress tab for the DSH right sidebar (session turn status + long-task progress).",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zengxiaolou/dsh-session-rail"
  },
  "homepage": "https://github.com/zengxiaolou/dsh-session-rail",
  "bugs": {
    "url": "https://github.com/zengxiaolou/dsh-session-rail/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ]
}
